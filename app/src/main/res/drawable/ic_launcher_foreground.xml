<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Kept within the 66dp adaptive-icon safe zone (centered circle, radius 33 around 54,54)
         so it survives circle/squircle/rounded-square masking on every launcher. Matches the real
         YunoLMS brand mark: a bold, flat-edged geometric "Y" (not the old thin rounded-stroke
         placeholder) — same two-arm-into-stem skeleton, drawn as one path for the arms so they
         join in a clean point instead of two independently-capped strokes, plus a separate flat
         stem — with a heavier stroke and flat (butt) caps to match the logo's weight. -->
    <path
        android:strokeColor="@color/white"
        android:strokeWidth="17"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter"
        android:pathData="M31,29 L54,53 L77,29 M54,53 L54,81" />
</vector>
