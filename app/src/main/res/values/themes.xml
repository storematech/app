<resources>
    <style name="Theme.QuizMaker" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Applied to MainActivity only until installSplashScreen() switches it over to
         Theme.QuizMaker (see postSplashScreenTheme) once the first frame is ready. -->
    <style name="Theme.QuizMaker.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_indigo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.QuizMaker</item>
    </style>
</resources>
